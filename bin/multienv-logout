#!/usr/bin/env python3
"""Ask applications to close; leave save dialogs and the session alive by default."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import tomllib

def run(command, **kwargs):
    return subprocess.run(command, timeout=10, **kwargs)

def clients():
    result = run(['hyprctl', 'clients', '-j'], capture_output=True, text=True, check=True)
    data = json.loads(result.stdout)
    if not isinstance(data, list): raise ValueError('Invalid compositor window response')
    return data

def ancestor_pids(pid):
    """UWSM's main process can be the launcher parent of Hyprland."""
    found = set()
    for _ in range(16):
        if pid <= 1 or str(pid) in found: break
        proc = Path('/proc') / str(pid)
        try:
            if proc.stat().st_uid != os.getuid(): break
            found.add(str(pid))
            fields = (proc / 'stat').read_text().rsplit(')', 1)[1].split()
            pid = int(fields[1])
        except (OSError, ValueError, IndexError): break
    return found

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--greeter', action='store_true', help='Require manual greeter selection before logging out')
    parser.add_argument('--force', action='store_true', help='Explicitly exit even with remaining windows')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--timeout', type=float, default=8)
    args = parser.parse_args()
    if not 0 <= args.timeout <= 120: parser.error('timeout must be between 0 and 120 seconds')
    if args.greeter:
        candidates = [Path(os.environ['MULTIENV_CONFIG'])] if os.environ.get('MULTIENV_CONFIG') else [Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))/'multienv/multienv.toml', Path('/etc/multienv/multienv.toml')]
        cfg_file = next((path for path in candidates if path.is_file()), None)
        cfg = tomllib.loads(cfg_file.read_text()) if cfg_file else {}
        autologin = Path(os.path.expanduser(os.path.expandvars(cfg.get('general', {}).get('sddm_autologin_path', '/etc/sddm.conf.d/autologin.conf'))))
        if autologin.is_file():
            message = 'Desktop switching needs the manual greeter. Run multienv fallback first; login policy was not changed.'
            print(message, file=sys.stderr)
            if not args.dry_run:
                try: run(['notify-send', 'Desktop switch paused', message], capture_output=True)
                except FileNotFoundError: pass
            return 3
    if args.dry_run:
        print('Would request window closure, wait for save dialogs, then end the current session.'); return 0
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        print('No selected compositor instance; logout cancelled.', file=sys.stderr); return 1
    # Serialize duplicate UI requests without a detached shutdown watchdog.
    import fcntl
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp'))
    lock_path = runtime / ('multienv-logout-' + str(os.getuid()) + '.lock')
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("A logout request is already running.", file=sys.stderr); return 4
        for client in clients():
            address = client.get('address', '')
            if isinstance(address, str) and address.startswith('0x'):
                run(['hyprctl', 'dispatch', 'closewindow', 'address:' + address], capture_output=True, check=True)
        deadline = time.monotonic() + args.timeout
        remaining = clients()
        while remaining and time.monotonic() < deadline:
            time.sleep(0.2); remaining = clients()
        if remaining and not args.force:
            message = 'Logout paused: save or close remaining windows, then try again.'
            print(message, file=sys.stderr)
            try: run(['notify-send', 'Logout paused', message], capture_output=True)
            except FileNotFoundError: pass
            return 2
        env_id = os.environ.get('MULTIENV_ACTIVE_ENV', '')
        config = os.environ.get('MULTIENV_CONFIG', '')
        if env_id:
            candidates = [Path(config)] if config else [Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))/'multienv/multienv.toml', Path('/etc/multienv/multienv.toml')]
            cfg = next((p for p in candidates if p.is_file()), None)
            if cfg:
                data = tomllib.loads(cfg.read_text())
                hook = data.get('environments', {}).get(env_id, {}).get('teardown', '')
                if hook:
                    expanded = os.path.expanduser(os.path.expandvars(hook))
                    run([expanded], check=True)
        # UWSM owns services in its envelope. Never kill unrelated processes.
        import shutil
        owned_uwsm = False
        if shutil.which('uwsm'):
            envelope = run(['systemctl', '--user', 'show', '--property=MainPID', '--value', 'wayland-wm@*.service'], capture_output=True, text=True)
            active_pids = set(envelope.stdout.split()) if envelope.returncode == 0 else set()
            instance_list = run(['hyprctl', 'instances', '-j'], capture_output=True, text=True, check=True)
            owned_uwsm = any(item.get('instance') == os.environ['HYPRLAND_INSTANCE_SIGNATURE'] and bool(ancestor_pids(int(item.get('pid', 0))) & active_pids) for item in json.loads(instance_list.stdout))
        if owned_uwsm:
            run(['uwsm', 'stop'], check=True)
        else:
            run(['hyprctl', 'dispatch', 'exit'], check=True)
        return 0

if __name__ == '__main__':
    try: sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('Logout cancelled: ' + str(error), file=sys.stderr); sys.exit(1)
