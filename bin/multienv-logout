#!/usr/bin/env bash
# ==============================================================================
# arch-multienv: Graceful Teardown & Seat Release Engine
# ==============================================================================
# Ensures graphical daemons, layer shells, and application windows close cleanly
# before the compositor exits, releasing the Wayland seat for the next profile.
# ==============================================================================

set -uo pipefail

ENV_ID="${MULTIENV_ACTIVE_ENV:-}"
CONFIG_PATH="${MULTIENV_CONFIG:-}"

echo "Initiating graceful multi-environment session teardown..."

# 1. Run environment-specific teardown hook if defined
if [[ -n "$ENV_ID" ]]; then
    TEARDOWN_HOOK="$(python3 -c "
import os
try:
    import tomllib
except ImportError:
    import tomli as tomllib
from pathlib import Path

cand = '${CONFIG_PATH}'
if not cand or not os.path.isfile(cand):
    for c in [
        os.path.expanduser('~/.config/multienv/multienv.toml'),
        '/etc/multienv/multienv.toml',
    ]:
        if os.path.isfile(c):
            cand = c
            break

try:
    with open(cand, 'rb') as f:
        data = tomllib.load(f)
    print(data.get('environments', {}).get('${ENV_ID}', {}).get('teardown', ''))
except Exception:
    print('')
" 2>/dev/null || true)"

    if [[ -n "$TEARDOWN_HOOK" ]]; then
        eval "TEARDOWN_HOOK=\"$TEARDOWN_HOOK\""
        if [[ -x "$TEARDOWN_HOOK" ]]; then
            echo "Executing teardown hook: $TEARDOWN_HOOK"
            "$TEARDOWN_HOOK" || true
        fi
    fi
fi

# 2. Stop known background graphical workers that could hold the Wayland seat open
# Common examples: video wallpaper daemons, standalone layer shells
for daemon in mpvpaper swww-daemon hyprpaper; do
    if pgrep -x "$daemon" >/dev/null 2>&1; then
        echo "Terminating $daemon..."
        pkill -x "$daemon" 2>/dev/null || true
    fi
done

# 3. Schedule non-blocking background watchdog to guarantee compositor termination
echo "Scheduling compositor shutdown watchdog (3s timeout)..."
nohup bash -c "sleep 3 && (command -v uwsm >/dev/null && uwsm stop 2>/dev/null || command -v hyprctl >/dev/null && hyprctl dispatch exit 2>/dev/null || true)" >/dev/null 2>&1 &

# 4. Gracefully close active client windows if hyprctl is available
if command -v hyprctl >/dev/null 2>&1; then
    echo "Broadcasting close request to active client windows..."
    # Retrieve addresses of open client windows and dispatch close requests
    hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json, subprocess
try:
    clients = json.load(sys.stdin)
    for c in clients:
        addr = c.get('address')
        if addr:
            subprocess.run(['hyprctl', 'dispatch', 'closewindow', f'address:{addr}'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception:
    pass
" 2>/dev/null || true
fi

# 5. Allow applications 1 second to flush data to disk
sleep 1

# 6. Stop compositor via UWSM if running, or via hyprctl
if command -v uwsm >/dev/null 2>&1 && [[ -n "${UWSM_ID:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "Stopping UWSM session envelope..."
    uwsm stop 2>/dev/null || true
elif command -v hyprctl >/dev/null 2>&1; then
    echo "Requesting Hyprland compositor exit..."
    hyprctl dispatch exit 2>/dev/null || true
fi

echo "Teardown sequence complete."
