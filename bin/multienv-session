#!/usr/bin/env python3
"""Resolve one profile without evaluating shell expressions; retain launch failures."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import threading
import time
import json
import tomllib

def expand(value): return os.path.expanduser(os.path.expandvars(value))

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config')
    parser.add_argument('environment')
    args = parser.parse_args()
    candidates = [Path(args.config or os.environ['MULTIENV_CONFIG'])] if args.config or os.environ.get('MULTIENV_CONFIG') else [Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))/'multienv/multienv.toml', Path('/etc/multienv/multienv.toml')]
    config = next((p for p in candidates if p.is_file()), None)
    if config is None: raise ValueError('No configuration found; refusing to launch a default profile.')
    data = tomllib.loads(config.read_text())
    profile = data.get('environments', {}).get(args.environment)
    if not isinstance(profile, dict): raise ValueError('Unknown environment')
    path = Path(expand(profile.get('config_path', '')))
    if not path.is_file(): raise ValueError('Profile configuration is missing')
    compositor = profile.get('compositor', 'hyprland')
    binary = shutil.which(compositor) or (shutil.which('Hyprland') if compositor == 'hyprland' else None)
    if not binary: raise ValueError('Compositor executable is missing')
    env = dict(os.environ, MULTIENV_ACTIVE_ENV=args.environment, MULTIENV_CONFIG=str(config.resolve()), XDG_CURRENT_DESKTOP=profile.get('desktop_names', 'Hyprland:'+args.environment))
    command = [binary, '--config', str(path)]
    manager = profile.get('session_manager', data.get('general', {}).get('session_manager', 'uwsm'))
    if manager == 'uwsm':
        uwsm = shutil.which('uwsm')
        if not uwsm: raise ValueError('UWSM selected but not installed')
        command = [uwsm, 'start', '-g', '-1', '-e', '-D', env['XDG_CURRENT_DESKTOP'], '--'] + command
    elif manager != 'direct': raise ValueError('Unsupported session manager')
    hook = expand(profile.get('autostart', ''))
    if hook and not os.access(hook, os.X_OK): raise ValueError('Autostart hook is not executable')
    previous = set()
    def instances():
        result = subprocess.run(['hyprctl', 'instances', '-j'], capture_output=True, text=True, timeout=3)
        if result.returncode: return []
        return json.loads(result.stdout)
    if hook:
        if compositor.lower() != 'hyprland': raise ValueError('Autostart readiness is supported for Hyprland; use the compositor configuration for other desktops')
        previous = {i.get('instance') for i in instances()}
    process = subprocess.Popen(command, env=env)
    def start_hook():
        deadline = time.monotonic() + 30
        while process.poll() is None and time.monotonic() < deadline:
            try:
                for instance in instances():
                    if instance.get('instance') in previous: continue
                    proc = Path('/proc')/str(instance.get('pid'))
                    if proc.stat().st_uid != os.getuid(): continue
                    argv = (proc/'cmdline').read_bytes().decode().split('\0')
                    if '--config' not in argv or Path(argv[argv.index('--config')+1]).resolve() != path.resolve(): continue
                    hook_env = dict(env, HYPRLAND_INSTANCE_SIGNATURE=instance['instance'], WAYLAND_DISPLAY=instance['wl_socket'])
                    subprocess.Popen([hook], env=hook_env)
                    return
            except (OSError, ValueError, subprocess.SubprocessError): pass
            time.sleep(0.2)
        print('Autostart hook was not run: selected compositor did not become ready.', file=sys.stderr)
    if hook: threading.Thread(target=start_hook, daemon=True).start()
    return process.wait()

if __name__ == '__main__':
    try: sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('Session launch failed: '+str(error), file=sys.stderr); sys.exit(1)
