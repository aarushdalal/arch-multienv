[Plymouth Theme]
Name=MultiEnv Monolith
Description=Theme-adaptive frosted glass Plymouth boot, unlock, and shutdown theme.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/multienv-monolith
ScriptFile=/usr/share/plymouth/themes/multienv-monolith/multienv-monolith.script
ConsoleLogBackgroundColor=0x08090d
MonospaceFont=Noto Sans 10
Font=Noto Sans 11
