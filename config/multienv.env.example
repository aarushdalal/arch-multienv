# Multi-Environment Architecture Shell Environment Variables
# Source this file or place in ~/.config/environment.d/50-multienv.conf

# Base configuration path
# MULTIENV_CONFIG_PATH="$HOME/.config/multienv/multienv.toml"

# Active environment identifier (set dynamically by session launcher)
# MULTIENV_ACTIVE_ENV="environment-a"

# Default state directory
# MULTIENV_STATE_DIR="$HOME/.local/state/multienv"
